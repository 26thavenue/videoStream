PORT = 8081
STORAGE_ENV=local

# LocalStack (dev)
LOCALSTACK_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

# Cloudflare R2 (prod)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com

# Shared bucket names (same names in both environments)
RAW_BUCKET=raw-videos
PROCESSED_BUCKET=processed-videos

# Postgres (job queue)
DATABASE_URL=postgres://postgres:devpass@localhost:5432/pipeline

# Reliability / job queue
MAX_ATTEMPTS=4
RETRY_BASE_MS=30000
RETRY_CAP_MS=3600000
STUCK_JOB_TTL_MIN=120

# Pipeline features
THUMBNAILS=true

# Playback proxy auth (optional; leave empty to skip auth on /videos/*)
PLAYBACK_TOKEN=

# Uptime beacons (optional) - GET heartbeat on boot + interval
UPTIME_PING_URL=
UPTIME_PING_INTERVAL_MS=300000

# Reserved for a future authenticated enqueue endpoint
# ADMIN_TOKEN=
